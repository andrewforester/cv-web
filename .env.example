# Copy to .env.local (git-ignored) for `npm run dev`. Server-side only: the Vite dev plugin
# (server/dev/chatApiPlugin.ts) reads these; nothing without a VITE_ prefix reaches the page.
# On Vercel set them in Project Settings -> Environment Variables (Production + Preview).

# Claude API key for /api/chat. Missing: /api/chat answers 503 unavailable.
ANTHROPIC_API_KEY=

# Optional. Allowlisted model: claude-haiku-4-5 (default) or claude-sonnet-5-5.
CHAT_MODEL=claude-haiku-4-5

# Optional kill switch: false makes /api/chat answer 503 unavailable.
CHAT_ENABLED=true

# Dev/tests only: 1 answers with scripted text, no key needed (and wins over a key: set 0 to
# talk to Claude). Ignored on Vercel.
# In the chat, start a message with /error, /fail, /refusal, /long or /slow to try those paths.
# v4 (page tools, English only): "show me his apps", "highlight Kotlin", "open contact", or
# /tool name=value ... (e.g. /tool scrollToSection=apps) answer with a tool round
# (scrollToSection, highlightElement, openContact); the follow-up with the results gets a short
# text answer.
CHAT_FAKE_LLM=1

# Optional soft daily budget in USD for this instance's estimated model spend (UTC day). Over it,
# /api/chat answers 503 unavailable with Retry-After until UTC midnight. Unset = off. Per
# instance and in memory only; the hard cap is the Anthropic workspace spend limit.
# CHAT_DAILY_BUDGET_USD=1

# Voice agent (docs/voice/): POST /api/voice-session mints ElevenLabs conversation tokens.
# Kill switch: only true lets it mint (unset or anything else: 503 unavailable).
VOICE_ENABLED=true

# ElevenLabs API key restricted to Agents, and the agent's id (agent_...). Missing either:
# /api/voice-session answers 503 unavailable (unless VOICE_FAKE=1).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Dev only: 1 returns the token "fake" after the same guards, without calling ElevenLabs (no
# key or agent needed). Ignored on Vercel.
VOICE_FAKE=1
